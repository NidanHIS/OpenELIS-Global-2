					<box topPadding="2" leftPadding="4" bottomPadding="2">
						<pen lineWidth="0.5"/>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.0"/>
					</box>
					<textElement verticalAlignment="Middle">
						<font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<text><![CDATA[Test Name]]></text>
				</staticText>
				<!-- Result -->
				<staticText>
					<reportElement mode="Opaque" x="200" y="18" width="190" height="15" forecolor="#FFFFFF" backcolor="#1F4E79"/>
					<box topPadding="2" bottomPadding="2">
						<pen lineWidth="0.5"/>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.0"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.0"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<text><![CDATA[Result]]></text>
				</staticText>
				<!-- Alert -->
				<staticText>
					<reportElement mode="Opaque" x="390" y="18" width="30" height="15" forecolor="#FFFFFF" backcolor="#1F4E79"/>
					<box topPadding="2" bottomPadding="2">
						<pen lineWidth="0.5"/>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.0"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.0"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<text><![CDATA[Alert]]></text>
				</staticText>
				<!-- Reference Value (Unit) -->
				<staticText>
					<reportElement mode="Opaque" x="420" y="18" width="133" height="15" forecolor="#FFFFFF" backcolor="#1F4E79"/>
					<box topPadding="2" bottomPadding="2">
						<pen lineWidth="0.5"/>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.0"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font fontName="SansSerif" size="8" isBold="true" pdfFontName="Helvetica-Bold"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<text><![CDATA[Reference Value (Unit)]]></text>
				</staticText>
			</band>
		</groupHeader>
		<groupFooter>
			<band/>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="2" splitType="Stretch">
			<line>
				<reportElement key="line" x="0" y="-45" width="534" height="1" forecolor="#000000"/>
				<graphicElement>
					<pen lineWidth="2.0" lineStyle="Solid"/>
				</graphicElement>
			</line>
		</band>
	</title>
	<pageHeader>
		<band height="124" splitType="Stretch">
			<subreport>
				<reportElement x="0" y="0" width="552" height="94" printWhenGroupChanges="person"/>
				<subreportParameter name="labName2">
					<subreportParameterExpression><![CDATA[$P{additionalSiteInfo}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="useSTNumber">
					<subreportParameterExpression><![CDATA[$P{useSTNumber}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="labName1">
					<subreportParameterExpression><![CDATA[$P{siteName}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="billingNumberLabel">
					<subreportParameterExpression><![CDATA[$P{billingNumberLabel}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="reportTitle">
					<subreportParameterExpression><![CDATA[$R{report.analysisReport}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="rightHeaderImage">
					<subreportParameterExpression><![CDATA[$P{rightHeaderImage}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="footerName">
					<subreportParameterExpression><![CDATA[$P{footerName}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="imagesPath">
					<subreportParameterExpression><![CDATA[$P{imagesPath}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="completeFlag">
					<subreportParameterExpression><![CDATA[$F{completeFlag}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="headerName">
					<subreportParameterExpression><![CDATA[$P{headerName}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="correctedReport">
					<subreportParameterExpression><![CDATA[$P{correctedReport}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="leftHeaderImage">
					<subreportParameterExpression><![CDATA[$P{leftHeaderImage}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="SUBREPORT_DIR">
					<subreportParameterExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="orderFinishDate">
					<subreportParameterExpression><![CDATA[$F{orderFinishDate}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="siteId">
					<subreportParameterExpression><![CDATA[$P{siteId}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="usePageNumbers">
					<subreportParameterExpression><![CDATA[$P{usePageNumbers}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="additionalSiteInfo">
					<subreportParameterExpression><![CDATA[$P{additionalSiteInfo}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="directorName">
					<subreportParameterExpression><![CDATA[$P{directorName}]]></subreportParameterExpression>
				</subreportParameter>
				<subreportParameter name="siteName">
					<subreportParameterExpression><![CDATA[$P{siteName}]]></subreportParameterExpression>
				</subreportParameter>
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource()]]></dataSourceExpression>
				<subreportExpression><![CDATA[$P{SUBREPORT_DIR} + $P{headerName}]]></subreportExpression>
			</subreport>
			<textField>
				<reportElement mode="Transparent" x="0" y="93" width="552" height="16" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[$F{correctedResult}]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Center" verticalAlignment="Bottom">
					<font size="12" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{report.correctedReport}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Opaque" x="1" y="110" width="550" height="13" backcolor="#E6E6E6"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{report.results} + " " + $F{completeFlag}]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>
	<columnHeader>
		<band splitType="Prevent"/>
	</columnHeader>
	<detail>
		<band height="29" splitType="Prevent">
			<rectangle>
				<reportElement positionType="Float" mode="Opaque" x="0" y="15" width="10" height="14" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" forecolor="#E6E6E6" backcolor="#CCCCCC" >
					<printWhenExpression><![CDATA[$F{note} != null]]></printWhenExpression>
				</reportElement>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</rectangle>
			<frame>
				<reportElement x="0" y="0" width="553" height="15" forecolor="#000000"/>
				<box>
					<pen lineWidth="0.5" lineColor="#CCCCCC"/>
					<topPen lineWidth="0.5" lineColor="#CCCCCC"/>
					<leftPen lineWidth="0.5" lineColor="#CCCCCC"/>
					<bottomPen lineWidth="0.5" lineColor="#CCCCCC"/>
					<rightPen lineWidth="0.5" lineColor="#CCCCCC"/>
				</box>
				<rectangle>
					<reportElement stretchType="RelativeToBandHeight" x="1" y="0" width="551" height="14" backcolor="#E0E0E0">
						<printWhenExpression><![CDATA[$F{parentMarker}]]></printWhenExpression>
					</reportElement>
					<graphicElement>
						<pen lineWidth="0.0"/>
					</graphicElement>
				</rectangle>
				<!-- Test Name: x=0, w=200 -->
				<textField textAdjust="StretchHeight">
					<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="200" height="15"/>
					<box topPadding="2" leftPadding="4" bottomPadding="2">
						<topPen lineWidth="0.0" lineColor="#CCCCCC"/>
						<leftPen lineWidth="0.0"/>
						<bottomPen lineWidth="0.0" lineColor="#CCCCCC"/>
						<rightPen lineWidth="0.0"/>
					</box>
					<textElement verticalAlignment="Middle" markup="html">
						<font size="8"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{testName}]]></textFieldExpression>
				</textField>
				<!-- Result: x=200, w=190 -->
				<textField textAdjust="StretchHeight" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToTallestObject" x="200" y="0" width="190" height="15"/>
					<box topPadding="2" bottomPadding="2" rightPadding="4">
						<topPen lineWidth="0.0" lineColor="#CCCCCC"/>
						<leftPen lineWidth="0.0"/>
						<bottomPen lineWidth="0.0" lineColor="#CCCCCC"/>
						<rightPen lineWidth="0.0"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
						<font fontName="SansSerif" size="8" isBold="false" isItalic="false" isUnderline="false" pdfFontName="Helvetica" isPdfEmbedded="true"/>
						<paragraph lineSpacing="Single" leftIndent="4"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{result}]]></textFieldExpression>
				</textField>
				<!-- Alert: x=390, w=30 -->
				<textField isBlankWhenNull="true">
					<reportElement stretchType="RelativeToTallestObject" mode="Transparent" x="390" y="0" width="30" height="15" backcolor="#FFFFFF"/>
					<box>
						<leftPen lineWidth="0.0"/>
						<rightPen lineWidth="0.0"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle" markup="html">
						<font fontName="SansSerif" size="8" isBold="true"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{alerts}]]></textFieldExpression>
				</textField>
				<!-- Ref (Unit): x=420, w=133 — shows "40-50 (g/dL)" -->
				<textField isBlankWhenNull="true">
					<reportElement stretchType="RelativeToTallestObject" x="420" y="0" width="133" height="15"/>
					<box topPadding="2" bottomPadding="2">
						<topPen lineWidth="0.0" lineColor="#CCCCCC"/>
						<leftPen lineWidth="0.0"/>
						<bottomPen lineWidth="0.0" lineColor="#CCCCCC"/>
						<rightPen lineWidth="0.0"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle">
						<font size="8"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<textFieldExpression><![CDATA[($F{testRefRange} != null && !$F{testRefRange}.isEmpty()) ? ($F{uom} != null && !$F{uom}.isEmpty() ? $F{testRefRange} + " (" + $F{uom} + ")" : $F{testRefRange}) : ($F{uom} != null && !$F{uom}.isEmpty() ? $F{uom} : "")]]></textFieldExpression>
				</textField>
			</frame>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" mode="Opaque" x="10" y="15" width="543" height="14" isRemoveLineWhenBlank="true" backcolor="#F5F5F5">
					<printWhenExpression><![CDATA[$F{note} != null]]></printWhenExpression>
				</reportElement>
				<box topPadding="2" leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5" lineColor="#000000"/>
					<topPen lineWidth="0.5" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineColor="#000000"/>
				</box>
				<textElement markup="styled">
					<font size="8"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{note}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<columnFooter>
		<band height="28" splitType="Stretch">
			<!-- Row 1: Date of Report on the left -->
			<textField>
				<reportElement x="0" y="1" width="90" height="12"/>
				<box rightPadding="2"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="7" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{report.reportDate}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy HH.mm.ss">
				<reportElement x="91" y="1" width="150" height="12"/>
				<textElement verticalAlignment="Middle">
					<font size="7"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<!-- Row 2: Legend centered -->
			<textField>
				<reportElement x="0" y="14" width="552" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{report.legend} + "  B = " + $R{report.belowNormal} + "  E = " + $R{report.aboveNormal} + "  * = " + $R{report.abnormal} + "  R = " + $R{report.extLabReference} + "  C = " + $R{report.confirmTest}]]></textFieldExpression>
			</textField>
		</band>
	</columnFooter>
	<pageFooter>
		<band height="14" splitType="Stretch">
			<textField>
				<reportElement x="371" y="4" width="126" height="10">
					<printWhenExpression><![CDATA[$P{usePageNumbers}.equals("true")]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="7"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$R{report.label.page}+" "+$V{PAGE_NUMBER}+" "+$R{report.about}]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Group" evaluationGroup="Accession Number">
				<reportElement x="497" y="4" width="37" height="10">
					<printWhenExpression><![CDATA[$P{usePageNumbers}.equals("true")]]></printWhenExpression>
				</reportElement>
				<textElement verticalAlignment="Middle">
					<font size="7"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
