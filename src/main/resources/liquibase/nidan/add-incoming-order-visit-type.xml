<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="nidan-incoming-orders-add-visit-type-001" author="nidan">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="incoming_orders" columnName="visit_type"/>
            </not>
        </preConditions>

        <addColumn schemaName="clinlims" tableName="incoming_orders">
            <column name="visit_type" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
