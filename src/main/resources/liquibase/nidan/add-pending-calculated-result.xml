<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-pending-calculated-result" author="nidan">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="analysis" columnName="pending_calculated_value"/>
            </not>
        </preConditions>
        <addColumn schemaName="clinlims" tableName="analysis">
            <column name="pending_calculated_value" type="VARCHAR(255)"/>
            <column name="pending_calculation_name" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
