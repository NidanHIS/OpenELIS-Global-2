<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Nidan paywall visit-type bypass configuration.

        Three boolean SiteInformation rows control which OpenMRS visit types
        are exempt from the paywall check at collect-sample time.

        Defaults match the previous hardcoded behaviour:
            OPD → false (outpatient, enforce paywall by default)
            IPD → true  (inpatient, bypass by default — was hardcoded)
            ER  → true  (emergency, bypass by default — was hardcoded)

        Each property uses the idempotent UPDATE-or-INSERT pair pattern
        consistent with every other nidan liquibase changeset.

        domain_id uses the dedicated 'nidanPaywallConfig' domain so these rows
        are invisible to the generic PatientConfigurationMenu. The domain row is
        created idempotently in the same file before the three inserts.
        NidanPaywallConfigService reads by key name, not by domain — no service
        code changes required.
    -->

    <!-- ── Create dedicated domain (idempotent) ──────────────────────────── -->
    <!-- ── Widen name column size on site_information (idempotent) ──────── -->
    <changeSet id="widen-site-information-name-to-100" author="nidan">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="character varying(32)">
                SELECT data_type || '(' || character_maximum_length || ')'
                FROM information_schema.columns
                WHERE table_schema = 'clinlims'
                  AND table_name   = 'site_information'
                  AND column_name  = 'name'
            </sqlCheck>
        </preConditions>
        <comment>Increase site_information.name to 100 characters to support longer visit-type config keys</comment>
        <modifyDataType
            schemaName="clinlims"
            tableName="site_information"
            columnName="name"
            newDataType="VARCHAR(100)" />
    </changeSet>

    <!-- ── Create dedicated domain (idempotent) ──────────────────────────── -->
    <changeSet id="nidan-paywall-config-domain-insert" author="nidan">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.site_information_domain
                WHERE name = 'nidanPaywallConfig'
            </sqlCheck>
        </preConditions>
        <comment>Create dedicated site_information_domain for nidan paywall config rows</comment>
        <insert schemaName="clinlims" tableName="site_information_domain">
            <column name="id"           valueSequenceNext="site_information_domain_seq"/>
            <column name="name"         value="nidanPaywallConfig"/>
            <column name="description"  value="Nidan paywall visit-type bypass configuration. Managed exclusively via NidanPaywallConfigRestController."/>
        </insert>
    </changeSet>

    <!-- ── nidan_paywall_allow_visit_type_opd_visit ─────────────────────────── -->
    <changeSet id="nidan-paywall-visit-type-config-allow-opd-insert" author="nidan">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.site_information
                WHERE name = 'nidan_paywall_allow_visit_type_opd visit'
            </sqlCheck>
        </preConditions>
        <comment>Insert nidan_paywall_allow_visit_type_opd visit = false (OPD patients go through paywall by default)</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id"           valueSequenceNext="site_information_seq"/>
            <column name="name"         value="nidan_paywall_allow_visit_type_opd visit"/>
            <column name="description"  value="OPD Visit"/>
            <column name="value"        value="false"/>
            <column name="encrypted"    value="false"/>
            <column name="value_type"   value="boolean"/>
            <column name="domain_id"    valueComputed="(SELECT id FROM clinlims.site_information_domain WHERE name = 'nidanPaywallConfig')"/>
            <column name="group"        value="0"/>
            <column name="lastupdated"  valueComputed="now()"/>
        </insert>
    </changeSet>

    <!-- ── nidan_paywall_allow_visit_type_ipd_visit ─────────────────────────── -->
    <changeSet id="nidan-paywall-visit-type-config-allow-ipd-insert" author="nidan">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.site_information
                WHERE name = 'nidan_paywall_allow_visit_type_ipd visit'
            </sqlCheck>
        </preConditions>
        <comment>Insert nidan_paywall_allow_visit_type_ipd visit = true (IPD patients bypass paywall by default)</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id"           valueSequenceNext="site_information_seq"/>
            <column name="name"         value="nidan_paywall_allow_visit_type_ipd visit"/>
            <column name="description"  value="IPD Visit"/>
            <column name="value"        value="true"/>
            <column name="encrypted"    value="false"/>
            <column name="value_type"   value="boolean"/>
            <column name="domain_id"    valueComputed="(SELECT id FROM clinlims.site_information_domain WHERE name = 'nidanPaywallConfig')"/>
            <column name="group"        value="0"/>
            <column name="lastupdated"  valueComputed="now()"/>
        </insert>
    </changeSet>

    <!-- ── nidan_paywall_allow_visit_type_er_visit ──────────────────────────── -->
    <changeSet id="nidan-paywall-visit-type-config-allow-er-insert" author="nidan">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.site_information
                WHERE name = 'nidan_paywall_allow_visit_type_er visit'
            </sqlCheck>
        </preConditions>
        <comment>Insert nidan_paywall_allow_visit_type_er visit = true (ER emergency patients bypass paywall by default)</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id"           valueSequenceNext="site_information_seq"/>
            <column name="name"         value="nidan_paywall_allow_visit_type_er visit"/>
            <column name="description"  value="ER Visit"/>
            <column name="value"        value="true"/>
            <column name="encrypted"    value="false"/>
            <column name="value_type"   value="boolean"/>
            <column name="domain_id"    valueComputed="(SELECT id FROM clinlims.site_information_domain WHERE name = 'nidanPaywallConfig')"/>
            <column name="group"        value="0"/>
            <column name="lastupdated"  valueComputed="now()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
