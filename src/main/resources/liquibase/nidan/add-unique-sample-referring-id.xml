<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="Pravin Timalsina" id="nidan-sample-referring-id-unique-001">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1)
                FROM pg_constraint c
                WHERE c.conname = 'unique_sample_referring_id'
            </sqlCheck>
        </preConditions>

        <addUniqueConstraint schemaName="clinlims" tableName="sample" columnNames="referring_id"
            constraintName="unique_sample_referring_id" />
    </changeSet>

</databaseChangeLog>
