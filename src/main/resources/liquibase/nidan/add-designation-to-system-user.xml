<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Adds designation column (VARCHAR(255)) to clinlims.system_user table -->
    <changeSet id="add-designation-to-system-user" author="nidan">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="system_user" columnName="designation"/>
            </not>
        </preConditions>
        <addColumn schemaName="clinlims" tableName="system_user">
            <column name="designation" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
