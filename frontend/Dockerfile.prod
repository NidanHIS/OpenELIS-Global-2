# build env
# --platform=$BUILDPLATFORM pins this stage to the runner's native platform (linux/amd64 on GHA).
# npm ci + npm run build run at full native speed instead of under arm64 QEMU emulation.
# The output (HTML/CSS/JS) is platform-agnostic and gets COPY'd into both amd64+arm64 nginx stages.
FROM --platform=$BUILDPLATFORM node:20.20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
# preferred, but there appears to be some overlap 
# RUN npm ci --omit=dev
COPY . ./
# preferred, but there appears to be issues
# COPY ./src ./src
# COPY ./public ./public
# COPY ./tsconfig.json ./tsconfig.json
# COPY ./.prettierrc.json ./.prettierrc.json
# COPY ./.eslintrc.js ./.eslintrc.js

# Disable ESLint during production build - linting happens in CI, not deployment
ENV DISABLE_ESLINT_PLUGIN=true
RUN npm run build

# production env
FROM nginx:1.15-alpine
USER root
COPY --from=build /app/build /usr/share/nginx/html
COPY --from=build /app/nginx/nginx.conf /etc/nginx/conf.d/default.conf

RUN apk update; \
    apk upgrade; \
    apk add curl; \
    apk add bash

ADD nginx/healthcheck.sh /healthcheck.sh
RUN chown nginx:nginx /healthcheck.sh; \
    chmod 770 /healthcheck.sh;

CMD ["nginx", "-g", "daemon off;"]
